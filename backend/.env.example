# ─── Core Application Configuration ──────────────────────────────────────────
PROJECT_NAME="Lexora Legal Case Management System"
VERSION="1.0.0"
ENVIRONMENT="development"
DEBUG=True

# ─── Security & Authentication ────────────────────────────────────────────────
SECRET_KEY="YOUR_SUPER_SECRET_JWT_KEY_CHANGE_THIS_IN_PRODUCTION"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── Database Configuration ───────────────────────────────────────────────────
DATABASE_URL="mysql+pymysql://db_user:db_password@localhost:3306/legalcase_management"

# ─── File Storage Configuration ───────────────────────────────────────────────
UPLOAD_DIR="uploads"

# ─── CORS Configuration ───────────────────────────────────────────────────────
CORS_ORIGINS='["http://localhost:5173", "http://localhost:3000", "http://127.0.0.1:5173"]'

# ─── Email / SMTP Configuration ───────────────────────────────────────────────
MAIL_USERNAME="your_gmail@gmail.com"
MAIL_PASSWORD="your_16_char_app_password"
MAIL_FROM="your_gmail@gmail.com"
MAIL_FROM_NAME="Lexora Legal Systems"
MAIL_SERVER="smtp.gmail.com"
MAIL_PORT=587
